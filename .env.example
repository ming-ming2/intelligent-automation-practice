# Copy to .env only when .env does not already exist. Never commit real keys.
DART_API_KEY=
OPENAI_API_KEY=

# Shared defaults. Application code must read these variables when implemented.
CREWAI_MODEL=openai/gpt-4o-mini
DART_DB_PATH=data/dart.db
DART_RAW_DIR=data/raw
RESULTS_DIR=results

# Disable telemetry for local development.
OTEL_SDK_DISABLED=true
CREWAI_TELEMETRY_DISABLED=true
